# Base URL of the eWARP backend API (contract: docs/openapi.yaml), read on the server only.
# Leave unset to use the demo data in src/lib/api/demo.
# FEEDBACK_API_URL=http://localhost:4000/api/v1

# Demo data only: password for the demo accounts admin@demo.test and viewer@demo.test (default ewarp-demo).
# The login page also has one-click "Demo admin" / "Demo viewer" buttons while a browser uses demo data.
# DEMO_PASSWORD=

# Demo data only: delay every demo API call by this many milliseconds to preview loading states.
# DEMO_API_LATENCY_MS=1500
